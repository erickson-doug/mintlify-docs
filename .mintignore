# Mintlify automatically ignores these files and directories:
# .git, .github, .claude, .agents, .idea, node_modules,
# README.md, LICENSE.md, CHANGELOG.md, CONTRIBUTING.md

# Local IDE / steering state (specs, migration tooling, design docs).
.kiro/

# Migration source — read-only, never rendered by Mintlify.
_old_sphinx_rst_docs/

# Draft content
drafts/
*.draft.mdx

